#
# Beispiel-Konfiguration. Kopieren nach `.env` und anpassen. Keine echten Secrets committen.

# Datenbank (Standard-Profil / Compose)
PGUSER=opencivic
PGPASSWORD=changeme
PGDATABASE=opencivic
# Von API/CLI genutzte Verbindungszeichenfolge (Solo-Default: lokaler Cluster auf 5433)
DATABASE_URL=postgresql://opencivic:changeme@db:5432/opencivic

# Ports
API_PORT=3001
WEB_PORT=3000

# Web → API
OPENCIVIC_API_URL=http://api:3001

# Observability (OpenTelemetry). Auf 'true' setzen, um Tracing im Solo-Profil abzuschalten.
OTEL_SDK_DISABLED=false
